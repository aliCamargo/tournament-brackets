{
  "name": "@ali.camargo/tournament-brackets",
  "version": "1.3.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "description": "Reusable single-elimination tournament brackets — vanilla ESM core with optional jQuery and React adapters",
  "main": "./dist/brackets.umd.cjs",
  "module": "./dist/brackets.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliCamargo/tournament-brackets.git"
  },
  "homepage": "https://alicamargo.github.io/tournament-brackets/",
  "bugs": {
    "url": "https://github.com/aliCamargo/tournament-brackets/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/brackets.js",
      "require": "./dist/brackets.umd.cjs"
    },
    "./jquery": {
      "types": "./dist/adapters/jquery.d.ts",
      "import": "./dist/jquery-adapter.js",
      "require": "./dist/jquery-adapter.umd.cjs"
    },
    "./react": {
      "types": "./dist/adapters/react.adapter.d.ts",
      "import": "./dist/react-adapter.js",
      "require": "./dist/react-adapter.umd.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./style.css": "./dist/brackets.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.js",
    "build:demo": "vite build --config vite.demo.config.js",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.jquery.config.js && vite build --config vite.react.config.js && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "jquery": ">=3.0.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "jquery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^8.20.1",
    "@testing-library/react": "^12.1.5",
    "@types/jquery": "^4.0.1",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "jquery": "^3.7.1",
    "jsdom": "^24.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "typescript": "^7.0.2",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "tournament",
    "brackets",
    "single-elimination",
    "vanilla-js",
    "jquery",
    "react"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Ali Camargo"
}
